# Copie para .env.local (ou cadastre em Vercel → Settings → Environment Variables)

# Google Analytics 4 — ID do fluxo de dados (ex.: G-XXXXXXXXXX). Sem ele, nenhum script de rastreamento é carregado.
NEXT_PUBLIC_GA_ID=

# Search Console — só se escolher verificação por meta tag (a verificação por DNS é preferível).
NEXT_PUBLIC_GSC_VERIFICATION=
